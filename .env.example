# Where the Django API runs. Only this site's server talks to it; browsers never do.
API_URL=http://127.0.0.1:8000
# The public address of this site (for canonical links and the sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret with the API (same value as SITE_SERVER_KEY in the API's .env). Server-only: never sent to browsers.
SITE_SERVER_KEY=
